  "interpretation": {
    "ActionKind1": "open bolt; no invented persistent chamber/+1; Thompson, Mac10, MKB42, Boomy catalog members",
    "ActionKind2": "no manual action step; energy, tanks, rockets and projectiles use their own stock resources",
    "ActionKind3": "notch-lock action MP5/UMP; tracked feed remains exact-class audited",
    "chamber": "VRWeaponRuntime.TracksMagazineFeedClass gates single feeds; AF2011 has two; revolvers use cylinder capacity with no +1",
    "paid_magazine": "VRMagazineCarryRecipe.Supports excludes no-eject, parked, plateau, notify-seat, cylinder, gas-tank and blade-container cases; catalog membership alone does not imply recoverable magazine",
    "insert_policy": "VRMagazinePayloadLedger.Insert production policy LOAD ALL; preserve paid excess even above target perk capacity",
    "loss_off": "removed gun rounds return to reserve, payload actual paid rounds zero; cosmetic rounds must not be charged again",
    "recovery_off": "do not assume destruction; observer must distinguish inability to grab from retired/destroyed ledger contents"
  },
  "invariants": [
    "Same exact owned actor and pawn lifetime; unique removal serials and payload source/family",
    "Gun loaded + shared reserve once + live paid escrow + confirmed shots + accepted discarded live ammo = observed initial total + explicit grants only",
    "Prop Rounds/Carrier/CarrierHand agree with authority ledger; zero shells never return ammo",
    "Recovery claim/release changes no total; pouch credits only actual capacity room and leaves excess leased",
    "Insertion consumes one payload once; repeat/late receipt cannot refill or double debit",
    "Native magazine/chamber flags change availability, never add ammunition",
    "Partial action stroke or empty chamber emits no phantom cartridge; full stroke creates one accepted effect per actual extracted chamber",
    "Manual ejection uses existing live/spent assets and action audio; firing-only muzzle flash/recoil must stay unchanged"
  ],

// Harpoon attribution stays on Breacher with independent weapon ancestry.
class BreacherRipcordDamage extends KFDT_Piercing abstract hidedropdown;

defaultproperties
{
    WeaponDef=class'BreacherRipcordDefinition'
    ModifierPerkList(0)=class'BreacherPerk'
    KDamageImpulse=600
    KDeathUpKick=200
    KDeathVel=150
    StumblePower=20
    GunHitPower=20
}

// Exact first-person mesh identities for the native fixed-root surface catalog.
class VRWeaponBlockSurfaceIds extends Object;
static function int Get(KFWeapon W)
{
    local string Mesh;
    if(W==None) return 0;
    Mesh=Caps(W.FirstPersonMeshName);
    if(Mesh=="WEP_1P_HX25_PISTOL_MESH.WEP_1STP_HX25_PISTOL_RIG") return 1;
    if(Mesh=="WEP_1P_M14EBR_MESH.WEP_1STP_M14_EBR") return 2;
    if(Mesh=="WEP_1P_AF2001_MESH.WEP_1STP_AF2001_RIG") return 3;
    if(Mesh=="WEP_1P_FLAREGUN_MESH.WEP_1STP_FLAREGUN_RIG") return 4;
    if(Mesh=="WEP_1P_HRG_WINTERBITE_MESH.WEP_1STP_HRG_WINTERBITE_RIG") return 5;
    if(Mesh=="WEP_1P_G18C_MESH.WEP_1STP_G18C_RIG") return 6;
    if(Mesh=="WEP_1P_HRG_93R_PISTOL_MESH.WEP_1P_HRG_93R_PISTOL_RIG") return 7;
    if(Mesh=="WEP_1P_M1911_MESH.WEP_1STP_M1911_RIG") return 8;
    if(Mesh=="WEP_1P_BLADEDPISTOL_MESH.WEP_1STP_BLADEDPISTOL_RIG") return 9;
    if(Mesh=="WEP_1P_SAIGA12_MESH.WEP_1STP_SAIGA12_RIG") return 10;
    if(Mesh=="WEP_1P_MG3_MESH.WEP_1STP_MG3_RIG") return 11;
    if(Mesh=="WEP_1P_AR15_9MM_MESH.WEP_1STP_AR15_9MM_RIG") return 12;
    if(Mesh=="WEP_1P_M4SHOTGUN_MESH.WEP_1STP_M4SHOTGUN_RIG") return 13;
    return 0;
}

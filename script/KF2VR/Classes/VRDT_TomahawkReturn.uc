// The recalled RAVEN-7's return sweep (#87): a small electric strike on each
// Zed it passes, with the stock EMP grenade's full EMP power so the pass
// stuns. Damage is ReturnFraction of the throw (VRTomahawkProjectile).
class VRDT_TomahawkReturn extends VRDT_TomahawkShock;

defaultproperties
{
    EMPPower=100
}

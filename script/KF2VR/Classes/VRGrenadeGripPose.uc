// Authored grenade presentation only. Generated by tools/author_grenade_grips.py.
// Reviewed fixed deltas and held-body placement are tracked in tools/grenade-grip-poses.json.
// Fixed local rotations on the existing floating-hand rig; no contact solver.
// Order: profile, Left/Right, Thumb/Index/Middle/Ring/Pinky, joints 1..3.
class VRGrenadeGripPose extends Object;

var array<quat> Rotations;

static function int ProfileFor(name ProjectileClass)
{
    switch (ProjectileClass)
    {
        case 'KFProj_FragGrenade': return 0;
        case 'KFProj_HEGrenade': return 5;
        case 'KFProj_EMPGrenade': return 1;
        case 'KFProj_FlashBangGrenade': return 6;
        case 'KFProj_FreezeGrenade': return 7;
        case 'KFProj_MedicGrenade': return 8;
        case 'KFProj_DynamiteGrenade': return 3;
        case 'KFProj_MolotovGrenade': return 4;
        case 'KFProj_NailBombGrenade': return 9;
    }
    return -1;
}

// X toward fingertips, Y toward thumb, Z out of palm, in UU.
// This is a visual offset; grab anchors and launch positions remain stock.
static function vector HeldOffset(name ProjectileClass)
{
    switch (ProjectileClass)
    {
        case 'KFProj_FragGrenade': return vect(8.5,0,3.8);
        case 'KFProj_HEGrenade': return vect(8.5,0,4.0);
        case 'KFProj_EMPGrenade': return vect(8.5,-0.1,3.7);
        case 'KFProj_FlashBangGrenade': return vect(8.5,0,3.7);
        case 'KFProj_FreezeGrenade': return vect(9,0,7.8);
        case 'KFProj_MedicGrenade': return vect(9,0,7.3);
        case 'KFProj_DynamiteGrenade': return vect(7.99422611283802,1.2072262374921896,3.898246344820817);
        case 'KFProj_MolotovGrenade': return vect(8.5,0,5.2);
        case 'KFProj_NailBombGrenade': return vect(8.5,-7,5.2);
    }
    return vect(8.5,0,3);
}

// Columns of the visual rotation in the anatomical hand frame.
static function bool HeldAxes(name ProjectileClass, out vector Forward, out vector Thumb)
{
    switch (ProjectileClass)
    {
        case 'KFProj_DynamiteGrenade':
            Forward = vect(0.943809509,-0.299953818,-0.138749078);
            Thumb = vect(0.312356889,0.946757555,0.077995636);
            return true;
        case 'KFProj_EMPGrenade':
            Forward = vect(1.000000000,0.000000000,0.000000000);
            Thumb = vect(0.000000000,1.000000000,0.000000000);
            return true;
        case 'KFProj_FlashBangGrenade':
            Forward = vect(1.000000000,0.000000000,0.000000000);
            Thumb = vect(0.000000000,1.000000000,0.000000000);
            return true;
        case 'KFProj_FreezeGrenade':
            Forward = vect(1.000000000,0.000000000,0.000000000);
            Thumb = vect(0.000000000,1.000000000,0.000000000);
            return true;
        case 'KFProj_MedicGrenade':
            Forward = vect(1.000000000,0.000000000,0.000000000);
            Thumb = vect(0.000000000,1.000000000,0.000000000);
            return true;
    }
    return false;
}

static function bool Read(int Profile, int Hand, int Joint, out quat Rotation)
{
    local int Index;
    if (Profile < 0 || Hand < 0 || Hand > 1 || Joint < 0 || Joint >= 15) return false;
    Index = Profile * 30 + Hand * 15 + Joint;
    if (Index >= default.Rotations.Length) return false;
    Rotation = default.Rotations[Index];
    return class'VRHandRolePose'.static.ValidQuaternion(Rotation);
}

